# ---------- Required ----------
PORT=5000
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# ---------- App ----------
NODE_ENV=development
# Timezone used for "today", time slots and monthly revenue
APP_TIMEZONE=Asia/Kolkata
BRAND_NAME=Luxe Hair
# Comma-separated frontend origins allowed by CORS (client site, admin panel)
CLIENT_URLS=http://localhost:5173,http://localhost:5174
# Public URL of the customer site (used for links in emails)
PUBLIC_SITE_URL=http://localhost:5173

# ---------- Email (Gmail app password) ----------
EMAIL_USER=you@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# ---------- Online payments ----------
# Online payment is a built-in DEMO checkout (no gateway, no keys, no real money).
# Enable/disable it in Admin -> Offers & payments.

# ---------- Image storage (optional) ----------
# From your Cloudinary dashboard. Leave all three blank to store images in server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
